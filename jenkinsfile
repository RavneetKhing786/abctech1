pipeline {
    agent any
    tools {
        maven 'my-maven'
        jdk 'MYJDK'
        Docker 'MY-DOCKER-HUB'
    }
    stages {
        stage('Initialize') {
            steps {
                sh '''
                    echo '🔧 Initializing environment...'
                    echo "MAVEN_HOME = ${MAVEN_HOME}"
                    echo "JDK_HOME = ${JDK_HOME}"
                    echo "WORKSPACE = ${WORKSPACE}"
                    echo "BUILD_NUMBER = ${BUILD_NUMBER}"
                    echo "JOB_NAME = ${JOB_NAME}"
                    echo "PATH = ${PATH}"
                    echo "M2_HOME = ${M2_HOME}"
                    echo "JAVA_HOME = ${JAVA_HOME}"
                '''
               
            }
        }

        stage('Checkout') {
            steps {
                echo '🔄 Checking out code on git repo...'
                git url: 'https://github.com/RavneetKhing786/abctech1.git', branch: 'master'
            }
        }

        stage('Build') {
            steps {
                echo '🔨 Building the project with compiler...'
                sh 'mvn clean compile'
            }
        }

        stage('Test') {
            steps {
                echo '🧪 Running tests on projects...'
                sh 'mvn test'
            }
        }

        stage('Package') {
            steps {
                echo '📦 Packaging the app or project...'
                sh 'mvn package'
                archiveArtifacts artifacts: 'target/*.war', fingerprint: true
            }
        }

        stage('Build Docker Image')
        {
            steps
            {
                echo '🚀 copy War file from target to jenkins source  workspace and build the image on the war file'
                
                sh 'cp /var/lib/jenkins/workspace/$JOB_NAME/target/ABCtechnologies-1.0.war /var/lib/jenkins/workspace/$JOB_NAME/ABCtechnologies-1.0.war'
                sh 'docker build -t rav4coder/edu-abc-project-rep:$BUILD_NUMBER .'
                echo "Successfully, Docker image created with tag: $BUILD_NUMBER"

            }
        }

        stage('Push Docker Image') {
            steps {
                echo '🚀 Register to Docker hub registry and push image to docker hub repo'
                // Add deployment steps here
                // This step should not normally be used in your script. Consult the inline help for details.
                    withDockerRegistry([credentialsId: 'dockerhub-creds', toolName: 'MY-DOCKER-HUB', url: 'https://registry.hub.docker.com']){
                        // some block
                        sh 'docker push rav4coder/edu-abc-project-rep:$BUILD_NUMBER'
                        echo "Successfully,Docker image pushed to Docker Hub with tag: $BUILD_NUMBER"
                    }
            }
        }

        stage('Deploy as Docker Container') {
            steps {
                    echo '🚀 Deploying the app...'
                    sh 'docker run -itd --name abc-edu-project rav4coder/edu-abc-project-rep:$BUILD_NUMBER'
                    echo 'docker container is running'    
                 }
    }

    post {
        success {
            echo '✅ Build and packaging completed successfully!'
        }
        failure {
            echo '❌ Build failed. Please check logs.'
        }
    }
}
